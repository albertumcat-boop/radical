rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Submissions: cada creador sube a su propia carpeta ────────
    match /submissions/{uid}/{submissionId}/{fileName} {
      // Solo el propio usuario puede subir
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;  // máx 50 MB

      // El propio usuario o admins pueden leer
      // (en la práctica los URLs de descarga son públicos tras getDownloadURL)
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ── Imágenes de productos (admin) ─────────────────────────────
    match /products/{fileName} {
      allow read: if true;
      allow write: if false;  // solo via Firebase Console o backend
    }

    // ── Todo lo demás: denegado ───────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
